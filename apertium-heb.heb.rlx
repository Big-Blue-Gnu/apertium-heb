DELIMITERS = "<.>" "<..>" "<...>" "<!>" "<?>" "<¶>" ;
SOFT-DELIMITERS = "<,>" ;

# We can define sets for common tag clusters
LIST Case = (n sg) (n pl) ; # A set that matches either a Noun Singular or a Noun Plural
LIST N = n ;
LIST V = vblex, vaux ;
LIST Vblex = vblex ;
LIST Vaux = vaux;
LIST Det = det ;
LIST Prn = prn ;
SET Imp = (vblex imp) ;
SET Fut = (vblex fut) | (vaux fut) ;
SET Past = (vblex past) | (vaux past) ;
SET Pres = (vblex pres) | (vblex pres) ;

LIST M = m ;
LIST F = f ;

LIST Sg = sg ;
LIST Pl = pl ;

LIST P1 = p1 ;

SECTION

SELECT Prn IF (0 Det) (0 Prn) (1 N) ;
# Example (this): This [is a] cow.

SELECT Prn IF (0 Det) (0 Prn) (-1 N) (1 N) ;

# Verbs with person number: P1
SELECT P1 IF (0C Fut) (0C Past) (-1 (prn subj p1 sg)) ;

# Verbs with singular nouns or pronouns
SELECT Pl IF (0C Fut) (0C Imp) (0C Past) (0C Pres) (-1 (n subj sg) | (prn subj sg)) ;

# Verbs with plural nouns or pronouns
SELECT Pl IF (0C Fut) (0C Imp) (0C Past) (0C Pres) (-1 (n subj pl) | (prn subj pl)) ;

# If there is a singular noun to the right, I cannot be a verb or noun.
REMOVE N OR V IF (1 (n sg)) ;

# If there is a conjunction followed by a certain cohort of the same CASE as me, choose me.
SELECT $$Case IF (1 (cnjcoo) LINK 1C $$Case) ;

